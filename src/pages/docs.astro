          <h3>2D Collision Detection</h3>
          <div class="fn-group">
            <div class="fn">
              <div class="fn-sig">checkCollisionRecs(rec1: <span class="t">Rect</span>, rec2: <span class="t">Rect</span>): <span class="t">boolean</span></div>
