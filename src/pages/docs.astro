          <div class="fn-group">
            <div class="fn">
              <div class="fn-sig">drawLine(startX: <span class="t">number</span>, startY: <span class="t">number</span>, endX: <span class="t">number</span>, endY: <span class="t">number</span>, thickness: <span class="t">number</span>, color: <span class="t">Color</span>): <span class="t">void</span></div>
              <div class="fn-desc">Draws a line segment with the given thickness.</div>
            </div>
            <div class="fn">
              <div class="fn-sig">drawRect(x: <span class="t">number</span>, y: <span class="t">number</span>, width: <span class="t">number</span>, height: <span class="t">number</span>, color: <span class="t">Color</span>): <span class="t">void</span></div>
              <div class="fn-desc">Draws a filled rectangle.</div>
            </div>
            <div class="fn">
              <div class="fn-sig">drawRectRec(rec: <span class="t">Rect</span>, color: <span class="t">Color</span>): <span class="t">void</span></div>
              <div class="fn-desc">Draws a filled rectangle from a Rect object.</div>
            </div>
            <div class="fn">
              <div class="fn-sig">drawRectLines(x: <span class="t">number</span>, y: <span class="t">number</span>, width: <span class="t">number</span>, height: <span class="t">number</span>, thickness: <span class="t">number</span>, color: <span class="t">Color</span>): <span class="t">void</span></div>
              <div class="fn-desc">Draws a rectangle outline.</div>
            </div>
            <div class="fn">
              <div class="fn-sig">drawCircle(cx: <span class="t">number</span>, cy: <span class="t">number</span>, radius: <span class="t">number</span>, color: <span class="t">Color</span>): <span class="t">void</span></div>
              <div class="fn-desc">Draws a filled circle.</div>
            </div>
            <div class="fn">
              <div class="fn-sig">drawCircleLines(cx: <span class="t">number</span>, cy: <span class="t">number</span>, radius: <span class="t">number</span>, color: <span class="t">Color</span>): <span class="t">void</span></div>
              <div class="fn-desc">Draws a circle outline.</div>
            </div>
