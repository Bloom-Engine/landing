        <div id="example-pong" class="docs-section">
          <h2>Pong</h2>
          <p class="example-meta">~170 lines &middot; Beginner &middot; <a href="https://github.com/Bloom-Engine/engine/blob/main/examples/pong/main.ts" target="_blank" rel="noopener">View source</a></p>
          <p>Classic two-player Pong. Demonstrates the game loop, keyboard input, delta-time movement, 2D shapes, collision detection, text rendering, and score tracking.</p>
          <div class="example-teaches">
            <h4>What you'll learn</h4>
            <ul>
              <li>Game loop with <code>getDeltaTime()</code> for frame-rate independence</li>
              <li>Continuous input with <code>isKeyDown()</code> for paddle movement</li>
              <li>Rectangle collision with <code>checkCollisionRecs()</code></li>
              <li>Centered text using <code>measureText()</code></li>
              <li>Game state management (pause, scoring, ball reset)</li>
              <li>Value clamping with <code>clamp()</code> to keep paddles on screen</li>
            </ul>
          </div>
          <div class="code-window">
            <div class="code-header"><span class="code-dot r"></span><span class="code-dot y"></span><span class="code-dot g"></span><span class="code-title">Key pattern: paddle-ball collision</span></div>
            <pre><code><span class="kw">const</span> ballRect: Rect = {"{"}
  x: ballX - BALL_RADIUS, y: ballY - BALL_RADIUS,
  width: BALL_RADIUS * <span class="num">2</span>, height: BALL_RADIUS * <span class="num">2</span>
{"}"};

<span class="kw">if</span> (checkCollisionRecs(ballRect, leftPaddle) &amp;&amp; ballVelX &lt; <span class="num">0</span>) {"{"}
  ballVelX = -ballVelX;
  <span class="cmt">// Angle varies based on where ball hits paddle</span>
  <span class="kw">const</span> hitPos = (ballY - leftPaddleY) / PADDLE_HEIGHT;
  ballVelY = BALL_SPEED * (hitPos - <span class="num">0.5</span>) * <span class="num">2</span>;
{"}"}</code></pre>
          </div>
        </div>

        <div id="example-dungeon" class="docs-section">
