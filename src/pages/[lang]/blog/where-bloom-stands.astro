---
import BlogPostWhereBloomStands from "../../../components/BlogPostWhereBloomStands.astro";
import { locales, defaultLocale, isLocale, type Locale } from "../../../i18n/ui";

export function getStaticPaths() {
  return locales
    .filter((l) => l !== defaultLocale)
    .map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale: Locale = isLocale(lang) ? lang : defaultLocale;
---
<BlogPostWhereBloomStands locale={locale} />
