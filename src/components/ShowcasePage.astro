---
import Layout from "../layouts/Layout.astro";
import { tFor, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = tFor(locale);
const title = `${t("showcase.title")} — Bloom Engine`;

const games = [
  {
    name: "Bloom Jump",
    descKey: "showcase.bloomJump.desc",
    url: "https://apps.apple.com/us/app/bloom-jump/id6761447092",
    image: "/games/bloom-jump/mac.webp",
    altKey: "home.game.alt",
    platforms: "iPhone · iPad · Mac · Apple TV · Vision · Apple Watch · Android · Web",
    stores: [
      {
        label: "App Store",
        sublabel: "iOS · macOS · tvOS · visionOS",
        url: "https://apps.apple.com/us/app/bloom-jump/id6761447092",
        kind: "apple",
      },
      {
        label: "App Store",
        sublabel: "watchOS",
        url: "https://apps.apple.com/us/app/bloom-jump-watch/id6779528549",
        kind: "apple",
      },
      {
        label: "Google Play",
        sublabel: "Android",
        url: "https://play.google.com/store/apps/details?id=com.bloom.jump",
        kind: "google",
      },
      {
        label: "Web",
        sublabel: "bloomengine.dev/jump",
        url: "https://bloomengine.dev/jump/",
        kind: "web",
      },
    ],
  },
];
---

<Layout title={title} description={t("showcase.metaDescription")} locale={locale} pathWithoutLocale="/showcase">
  <section class="page-hero">
    <div class="container">
      <h1>{t("showcase.title")}</h1>
      <p class="page-desc">{t("showcase.desc")}</p>
    </div>
  </section>

  <section class="showcase">
    <div class="container">
      <div class="showcase-grid">
        {games.map((g) => (
          <div class="showcase-card">
            <a href={g.url} target="_blank" rel="noopener" class="showcase-preview">
              <img src={g.image} alt={t(g.altKey)} width="1640" height="1280" loading="lazy" />
            </a>
            <div class="showcase-info">
              <span class="showcase-live">{t("showcase.liveBadge")}</span>
              <h3>{g.name}</h3>
              <p>{g.descKey ? t(g.descKey) : ""}</p>
              <div class="showcase-stores">
                {g.stores.map((s) => (
                  <a href={s.url} target="_blank" rel="noopener" class="store-badge">
                    {s.kind === "apple" ? (
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
                    ) : s.kind === "google" ? (
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.6 2.1c-.3.3-.5.7-.5 1.2v17.4c0 .5.2.9.5 1.2l.1.1 9.7-9.7v-.2L3.7 2zM17 15.3l-3.2-3.2v-.2L17 8.7l.1.1 3.8 2.2c1.1.6 1.1 1.7 0 2.3zm-1-1.1l-2.4-2.4-7.5 7.5c.4.4 1 .4 1.6.1zm-9.9 5.3 7.5-7.5-7.5-7.5z"/></svg>
                    ) : (
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm6.93 6h-2.95a15.65 15.65 0 0 0-1.38-3.56A8.03 8.03 0 0 1 18.93 8zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14C4.1 13.36 4 12.69 4 12s.1-1.36.26-2h3.38c-.08.66-.14 1.32-.14 2 0 .68.06 1.34.14 2H4.26zm.82 2h2.95c.32 1.25.78 2.45 1.38 3.56A8.03 8.03 0 0 1 5.08 16zm2.95-8H5.08a8.03 8.03 0 0 1 4.33-3.56A15.65 15.65 0 0 0 8.03 8zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66c-.09-.66-.16-1.32-.16-2 0-.68.07-1.35.16-2h4.68c.09.65.16 1.32.16 2 0 .68-.07 1.34-.16 2zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95a8.03 8.03 0 0 1-4.33 3.56zM16.36 14c.08-.66.14-1.32.14-2 0-.68-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2h-3.38z"/></svg>
                    )}
                    <span class="store-badge-text">
                      <span class="store-badge-label">{s.label}</span>
                      <span class="store-badge-sub">{s.sublabel}</span>
                    </span>
                  </a>
                ))}
              </div>
              <span class="showcase-platforms">{g.platforms}</span>
            </div>
          </div>
        ))}
      </div>

      <div class="showcase-cta">
        <h2>{t("showcase.cta.title")}</h2>
        <p>{t("showcase.cta.desc")}</p>
        <a href="https://github.com/Bloom-Engine" target="_blank" rel="noopener" class="btn btn-primary">
          {t("showcase.cta.button")}
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 4rem 0 3rem;
    background: var(--bloom-light);
    text-align: center;
  }

  .page-desc {
    color: rgba(27, 42, 30, 0.6);
    font-size: 1.125rem;
    margin-top: 0.75rem;
  }

  .showcase {
    padding: 3rem 0 5rem;
  }

  .showcase-grid {
    display: grid;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .showcase-card {
    display: grid;
    grid-template-columns: 6fr 5fr;
    border-radius: 16px;
    overflow: hidden;
    background: var(--bloom-light);
    color: var(--bloom-dark);
    transition: transform 0.2s, box-shadow 0.2s;
    border: 1px solid rgba(27, 42, 30, 0.06);
  }

  .showcase-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
  }

  .showcase-preview {
    display: block;
  }

  .showcase-preview img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .showcase-info {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }

  .showcase-live {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    background: rgba(76, 175, 80, 0.12);
    color: var(--bloom-green-dark);
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .showcase-info h3 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .showcase-info p {
    color: rgba(27, 42, 30, 0.6);
    font-size: 0.9375rem;
    margin-bottom: 1.25rem;
    line-height: 1.6;
  }

  .showcase-stores {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .store-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.9rem;
    border-radius: 10px;
    background: var(--bloom-dark);
    color: #fff;
    text-decoration: none;
    transition: transform 0.15s, opacity 0.15s;
  }

  .store-badge:hover {
    transform: translateY(-2px);
    opacity: 0.9;
    color: #fff;
  }

  .store-badge svg {
    flex-shrink: 0;
  }

  .store-badge-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .store-badge-sub {
    font-size: 0.625rem;
    opacity: 0.7;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .store-badge-label {
    font-size: 0.875rem;
    font-weight: 700;
  }

  .showcase-platforms {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(27, 42, 30, 0.45);
  }

  .showcase-cta {
    text-align: center;
    padding: 3rem;
    background: var(--bloom-light);
    border-radius: 16px;
  }

  .showcase-cta p {
    color: rgba(27, 42, 30, 0.6);
    margin: 0.75rem auto 1.5rem;
    max-width: 400px;
  }

  @media (max-width: 768px) {
    .showcase-card {
      grid-template-columns: 1fr;
    }
  }
</style>
