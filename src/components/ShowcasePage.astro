---
import Layout from "../layouts/Layout.astro";
import { tFor, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = tFor(locale);
const title = `${t("showcase.title")} — Bloom Engine`;

const games = [
  {
    name: "Bloom Jump",
    descKey: "showcase.bloomJump.desc",
    url: "https://apps.apple.com/us/app/bloom-jump/id6761447092",
    image: "/games/bloom-jump/mac.webp",
    altKey: "home.game.alt",
    platforms: "iPhone · iPad · Mac",
  },
];
---

<Layout title={title} description={t("showcase.metaDescription")} locale={locale} pathWithoutLocale="/showcase">
  <section class="page-hero">
    <div class="container">
      <h1>{t("showcase.title")}</h1>
      <p class="page-desc">{t("showcase.desc")}</p>
    </div>
  </section>

  <section class="showcase">
    <div class="container">
      <div class="showcase-grid">
        {games.map((g) => (
          <a href={g.url} target="_blank" rel="noopener" class="showcase-card">
            <div class="showcase-preview">
              <img src={g.image} alt={t(g.altKey)} width="1640" height="1280" loading="lazy" />
            </div>
            <div class="showcase-info">
              <span class="showcase-live">{t("showcase.liveBadge")}</span>
              <h3>{g.name}</h3>
              <p>{g.descKey ? t(g.descKey) : ""}</p>
              <span class="showcase-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
                {t("home.game.cta")}
              </span>
              <span class="showcase-platforms">{g.platforms}</span>
            </div>
          </a>
        ))}
      </div>

      <div class="showcase-cta">
        <h2>{t("showcase.cta.title")}</h2>
        <p>{t("showcase.cta.desc")}</p>
        <a href="https://github.com/Bloom-Engine" target="_blank" rel="noopener" class="btn btn-primary">
          {t("showcase.cta.button")}
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 4rem 0 3rem;
    background: var(--bloom-light);
    text-align: center;
  }

  .page-desc {
    color: rgba(27, 42, 30, 0.6);
    font-size: 1.125rem;
    margin-top: 0.75rem;
  }

  .showcase {
    padding: 3rem 0 5rem;
  }

  .showcase-grid {
    display: grid;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .showcase-card {
    display: grid;
    grid-template-columns: 6fr 5fr;
    border-radius: 16px;
    overflow: hidden;
    background: var(--bloom-light);
    text-decoration: none;
    color: var(--bloom-dark);
    transition: transform 0.2s, box-shadow 0.2s;
    border: 1px solid rgba(27, 42, 30, 0.06);
  }

  .showcase-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
    color: var(--bloom-dark);
  }

  .showcase-preview img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .showcase-info {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }

  .showcase-live {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    background: rgba(76, 175, 80, 0.12);
    color: var(--bloom-green-dark);
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .showcase-info h3 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .showcase-info p {
    color: rgba(27, 42, 30, 0.6);
    font-size: 0.9375rem;
    margin-bottom: 1.25rem;
    line-height: 1.6;
  }

  .showcase-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--bloom-green);
    font-weight: 700;
    font-size: 0.875rem;
  }

  .showcase-platforms {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(27, 42, 30, 0.45);
  }

  .showcase-cta {
    text-align: center;
    padding: 3rem;
    background: var(--bloom-light);
    border-radius: 16px;
  }

  .showcase-cta p {
    color: rgba(27, 42, 30, 0.6);
    margin: 0.75rem auto 1.5rem;
    max-width: 400px;
  }

  @media (max-width: 768px) {
    .showcase-card {
      grid-template-columns: 1fr;
    }
  }
</style>
