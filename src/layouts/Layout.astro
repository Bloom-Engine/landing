---
import "../styles/global.css";
import {
  defaultLocale,
  locales,
  localeNames,
  localePath,
  tFor,
  type Locale,
} from "../i18n/ui";

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  /** Path within the site without locale prefix, e.g. "/", "/blog", "/blog/where-bloom-stands". Used for hreflang + language switcher. */
  pathWithoutLocale?: string;
}

const {
  title,
  locale = defaultLocale,
  pathWithoutLocale = "/",
} = Astro.props;

const t = tFor(locale);
const description = Astro.props.description ?? t("meta.defaultDescription");

const site = "https://bloomengine.dev";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {locales.map((alt) => (
      <link
        rel="alternate"
        hreflang={alt}
        href={`${site}${localePath(alt, pathWithoutLocale)}`}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={`${site}${localePath(defaultLocale, pathWithoutLocale)}`}
    />
    <!-- Privacy-friendly analytics by Plausible -->
    <script async is:inline src="https://plausible.io/js/pa-_05l1AgasM1zQHW_OOoaB.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
  </head>
  <body>
    <header class="site-header">
      <nav class="container nav">
        <a href={localePath(locale, "/")} class="nav-logo">
          <img src="/favicon.svg" alt="Bloom" width="32" height="32" />
          <span>Bloom Engine</span>
        </a>
        <div class="nav-links">
          <a href={localePath(locale, "/showcase")}>{t("nav.showcase")}</a>
          <a href="/docs">{t("nav.docs")}</a>
          <a href={localePath(locale, "/blog")}>{t("nav.blog")}</a>
          <a href="https://github.com/Bloom-Engine" target="_blank" rel="noopener">{t("nav.github")}</a>
          <div class="lang-switcher">
            <button class="lang-btn" aria-label={t("meta.languageLabel")} aria-haspopup="true" aria-expanded="false">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              <span>{localeNames[locale]}</span>
            </button>
            <div class="lang-menu" role="menu">
              {locales.map((alt) => (
                <a
                  href={`${localePath(alt, pathWithoutLocale)}`}
                  role="menuitem"
                  class={alt === locale ? "active" : ""}
                  hreflang={alt}
                >
                  {localeNames[alt]}
                </a>
              ))}
            </div>
          </div>
        </div>
        <button class="nav-toggle" aria-label={t("nav.toggleMenu")}>
          <span></span>
          <span></span>
          <span></span>
        </button>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <a href={localePath(locale, "/")} class="nav-logo">
            <img src="/favicon.svg" alt="Bloom" width="24" height="24" />
            <span>Bloom Engine</span>
          </a>
          <p class="footer-tagline">{t("footer.tagline")}</p>
        </div>
        <div class="footer-links">
          <div class="footer-col">
            <h4>{t("footer.project")}</h4>
            <a href={localePath(locale, "/showcase")}>{t("nav.showcase")}</a>
            <a href="/docs">{t("nav.docs")}</a>
            <a href={localePath(locale, "/blog")}>{t("nav.blog")}</a>
            <a href="https://github.com/Bloom-Engine" target="_blank" rel="noopener">{t("nav.github")}</a>
          </div>
          <div class="footer-col">
            <h4>{t("footer.community")}</h4>
            <a href="https://github.com/Bloom-Engine" target="_blank" rel="noopener">{t("footer.discussions")}</a>
            <a href="https://github.com/Bloom-Engine" target="_blank" rel="noopener">{t("footer.contributing")}</a>
          </div>
        </div>
      </div>
      <div class="footer-bottom container">
        <p>&copy; {new Date().getFullYear()} Bloom Engine. {t("footer.rights")}</p>
        <p class="footer-legal">
          <a href="/impressum">{t("footer.impressum")}</a>
          <span>·</span>
          <a href="/privacy">{t("footer.privacy")}</a>
        </p>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector('.nav-toggle');
      const links = document.querySelector('.nav-links');
      toggle?.addEventListener('click', () => {
        links?.classList.toggle('open');
        toggle.classList.toggle('open');
      });

      const langBtn = document.querySelector('.lang-btn');
      const langMenu = document.querySelector('.lang-menu');
      langBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = langMenu?.classList.toggle('open');
        langBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      document.addEventListener('click', (e) => {
        if (!(e.target as HTMLElement).closest('.lang-switcher')) {
          langMenu?.classList.remove('open');
          langBtn?.setAttribute('aria-expanded', 'false');
        }
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(27, 42, 30, 0.08);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.125rem;
    color: var(--bloom-dark);
    text-decoration: none;
  }

  .nav-logo:hover {
    color: var(--bloom-green);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-links > a {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--bloom-dark);
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-links > a:hover {
    color: var(--bloom-green);
  }

  /* Language switcher */
  .lang-switcher {
    position: relative;
  }

  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: transparent;
    border: 1px solid rgba(27, 42, 30, 0.12);
    border-radius: 8px;
    padding: 0.4rem 0.7rem;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--bloom-dark);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }

  .lang-btn:hover {
    border-color: var(--bloom-green);
    color: var(--bloom-green);
  }

  .lang-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    min-width: 180px;
    max-height: 320px;
    overflow-y: auto;
    background: var(--bloom-white);
    border: 1px solid rgba(27, 42, 30, 0.1);
    border-radius: 10px;
    padding: 0.4rem;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    display: none;
  }

  .lang-menu.open {
    display: block;
  }

  .lang-menu a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    font-size: 0.875rem;
    color: var(--bloom-dark);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }

  .lang-menu a:hover {
    background: var(--bloom-light);
    color: var(--bloom-green);
  }

  .lang-menu a.active {
    background: rgba(76, 175, 80, 0.12);
    color: var(--bloom-green-dark);
    font-weight: 700;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--bloom-dark);
    border-radius: 2px;
    transition: all 0.3s;
  }

  .nav-toggle.open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav-toggle.open span:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle.open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 768px) {
    .nav-links {
      gap: 1rem;
    }
  }

  @media (max-width: 640px) {
    .nav-toggle {
      display: flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      background: var(--bloom-white);
      flex-direction: column;
      padding: 1.5rem;
      gap: 1rem;
      border-bottom: 1px solid rgba(27, 42, 30, 0.08);
      align-items: stretch;
    }

    .nav-links.open {
      display: flex;
    }

    .lang-switcher {
      width: 100%;
    }

    .lang-btn {
      width: 100%;
      justify-content: space-between;
    }

    .lang-menu {
      position: static;
      margin-top: 0.5rem;
      width: 100%;
      box-shadow: none;
    }
  }

  .site-footer {
    background: var(--bloom-dark);
    color: rgba(255, 255, 255, 0.7);
    padding-top: 4rem;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 3rem;
    padding-bottom: 3rem;
  }

  .footer-brand .nav-logo {
    color: var(--bloom-white);
    margin-bottom: 0.5rem;
  }

  .footer-tagline {
    font-size: 0.875rem;
    opacity: 0.6;
  }

  .footer-links {
    display: flex;
    gap: 4rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-col h4 {
    color: var(--bloom-white);
    font-size: 0.875rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-col a {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-col a:hover {
    color: var(--bloom-green-light);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.5rem;
    text-align: center;
    font-size: 0.8125rem;
    opacity: 0.5;
  }

  .footer-legal {
    margin-top: 0.5rem;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }

  .footer-legal a {
    color: inherit;
    text-decoration: none;
  }

  .footer-legal a:hover {
    color: var(--bloom-green-light);
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      gap: 2rem;
    }

    .footer-links {
      gap: 2rem;
    }
  }
</style>
